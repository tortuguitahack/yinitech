# Copy to .env on the backend host. Never commit the filled .env file.
PORT=3000
NODE_ENV=development

# Browser origin (GitHub Pages project pages share this origin)
ALLOWED_ORIGINS=https://tortuguitahack.github.io,http://localhost:3000,http://127.0.0.1:3000

# Supabase server-side credentials (service role key must remain private)
SUPABASE_URL=https://ebqxqqpgbeivmvztskns.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe server-side credentials; configure webhook for /api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://tortuguitahack.github.io/yinitech/?checkout=success
STRIPE_CANCEL_URL=https://tortuguitahack.github.io/yinitech/?checkout=cancelled

# Whop webhook endpoint. Configure this exact URL in Whop only while the tunnel is active.
WHOP_WEBHOOK_PUBLIC_URL=https://whop-webhook-dihacktor.loca.lt/webhooks/whop
WHOP_WEBHOOK_SECRET=
WHOP_MAX_TIMESTAMP_AGE_SECONDS=300

# Do not mark manual transfers/QR/crypto paid automatically unless a provider API
# or a reviewed, audited reconciliation process actually confirms settlement.
