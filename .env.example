# Copy to .env on the backend host. Never commit the populated file.
PORT=3000
NODE_ENV=development

# Browser origin (GitHub Pages project pages share this origin)
ALLOWED_ORIGINS=https://tortuguitahack.github.io,http://localhost:3000,http://127.0.0.1:3000

# Local Supabase API URL reachable from the backend process/container.
# For a same-host local Supabase default this is often http://127.0.0.1:54321;
# if backend runs in a container, use the internal service/DNS address instead.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Stripe server-side credentials; configure webhook for /api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://tortuguitahack.github.io/yinitech/?checkout=success
STRIPE_CANCEL_URL=https://tortuguitahack.github.io/yinitech/?checkout=cancelled

# Whop webhook signing secret; configure a stable HTTPS endpoint in Whop
WHOP_WEBHOOK_PUBLIC_URL=https://YOUR-DOMAIN/webhooks/whop
WHOP_WEBHOOK_SECRET=
WHOP_MAX_TIMESTAMP_AGE_SECONDS=300

# Crypto intentionally disabled until a real on-chain verifier is implemented.
CRYPTO_VERIFICATION_ENABLED=false
CRYPTO_NETWORKS=
CRYPTO_RPC_URL=
CRYPTO_PROVIDER_API_KEY=
