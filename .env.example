# Copy this file to .env and add real values in your server
PORT=3000
CLIENT_URL=https://tortuguitahack.github.io
ALLOWED_ORIGINS=https://tortuguitahack.github.io,http://localhost:3000,http://127.0.0.1:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/success
STRIPE_CANCEL_URL=http://localhost:3000/cancel

# Optional override for manual payment instructions
PAYMENT_EMAIL=soporte@tu-dominio.com

# If you use a different domain later, set it here
PUBLIC_BASE_URL=http://localhost:3000
